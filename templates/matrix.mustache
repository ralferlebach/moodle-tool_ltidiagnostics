{{!
    @template tool_ltidiagnostics/matrix

    Function check: per service the evidence ladder, what the check needs, how to produce the missing evidence and
    drill-down links with their effect (read only or mutating).

    Example context (json):
    {
        "caption": "Function check",
        "intro": "Each row is one LTI service.",
        "limits": "A status is only as strong as its evidence.",
        "headers": {"feature": "Feature", "status": "Status", "reason": "Why", "next": "Next safe step", "ladder": "Evidence ladder",
            "step": "Step", "state": "State", "kind": "Evidence", "detail": "Detail", "howto": "How to produce the evidence",
            "actions": "Go to"},
        "rows": [
            {"feature": "ags", "label": "Assignment and Grade Services", "status": "configured", "statuslabel": "Configured",
             "badge": "bg-warning text-dark", "reason": "Switched on locally, not yet observed.", "next": "Perform a launch.",
             "checks": "Scope, source grade, core task, POST, consumer result.",
             "hashowto": true, "hasactions": true, "howto": [{"text": "Grade a learner."}],
             "actions": [{"label": "Grades (AGS)", "url": "#", "effect": "readonly", "effectlabel": "read only"}],
             "notes": [{"text": "Remote side cannot be observed."}],
             "steps": [{"step": "local", "stepname": "Local switch", "state": "Yes", "kind": "config", "detail": "Mode full", "time": ""}]}
        ]
    }
}}
<p class="text-muted">{{intro}}</p>
<div class="table-responsive">
<table class="table generaltable" id="tool_ltidiagnostics_matrix">
    <caption>{{caption}}</caption>
    <thead>
        <tr>
            <th scope="col">{{headers.feature}}</th>
            <th scope="col">{{headers.status}}</th>
            <th scope="col">{{headers.reason}}</th>
            <th scope="col">{{headers.next}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr data-feature="{{feature}}" data-status="{{status}}">
            <th scope="row">{{label}}</th>
            <td><span class="badge {{badge}}">{{statuslabel}}</span></td>
            <td>
                {{reason}}
                {{#checks}}<div class="small">{{checks}}</div>{{/checks}}
                {{#notes}}<div class="small text-muted">{{text}}</div>{{/notes}}
                <details>
                    <summary>{{headers.ladder}}</summary>
                    <table class="table table-sm">
                        <caption class="accesshide">{{headers.ladder}}: {{label}}</caption>
                        <thead>
                            <tr>
                                <th scope="col">{{headers.step}}</th>
                                <th scope="col">{{headers.state}}</th>
                                <th scope="col">{{headers.kind}}</th>
                                <th scope="col">{{headers.detail}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#steps}}
                            <tr data-step="{{step}}">
                                <th scope="row">{{stepname}}</th>
                                <td>{{state}}</td>
                                <td>{{kind}}</td>
                                <td>{{detail}} {{#time}}<span class="small text-muted">{{time}}</span>{{/time}}</td>
                            </tr>
                            {{/steps}}
                        </tbody>
                    </table>
                </details>
                {{#hashowto}}
                <details class="ltidiag-howto" data-howto="{{feature}}">
                    <summary>{{headers.howto}}</summary>
                    <ol class="small">
                        {{#howto}}<li>{{text}}</li>{{/howto}}
                    </ol>
                </details>
                {{/hashowto}}
            </td>
            <td>
                {{next}}
                {{#hasactions}}
                <ul class="list-unstyled small mt-1 mb-0" aria-label="{{headers.actions}}: {{label}}">
                    {{#actions}}
                    <li><a href="{{url}}" data-effect="{{effect}}">{{label}}</a> <span class="badge bg-light text-dark border">{{effectlabel}}</span></li>
                    {{/actions}}
                </ul>
                {{/hasactions}}
            </td>
        </tr>
        {{/rows}}
    </tbody>
</table>
</div>
<p class="text-muted">{{limits}}</p>

{{!
    @template tool_ltidiagnostics/matrix

    Capability matrix with the evidence ladder for each feature.

    Example context (json):
    {
        "caption": "Capability matrix",
        "headers": {"feature": "Feature", "status": "Status", "reason": "Why", "next": "Next safe step", "ladder": "Evidence ladder",
            "step": "Step", "state": "State", "kind": "Evidence", "detail": "Detail"},
        "rows": [
            {"label": "Assignment and Grade Services", "status": "configured", "statuslabel": "Configured", "badge": "bg-warning text-dark",
             "reason": "Switched on locally, not yet observed.", "next": "Perform a launch.",
             "notes": [{"text": "Remote side cannot be observed."}],
             "steps": [{"stepname": "Local switch", "state": "Yes", "kind": "config", "detail": "Mode full", "time": ""}]}
        ]
    }
}}
<div class="table-responsive">
<table class="table generaltable" id="tool_ltidiagnostics_matrix">
    <caption>{{caption}}</caption>
    <thead>
        <tr>
            <th scope="col">{{headers.feature}}</th>
            <th scope="col">{{headers.status}}</th>
            <th scope="col">{{headers.reason}}</th>
            <th scope="col">{{headers.next}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr data-feature="{{feature}}" data-status="{{status}}">
            <th scope="row">{{label}}</th>
            <td><span class="badge {{badge}}">{{statuslabel}}</span></td>
            <td>
                {{reason}}
                {{#notes}}<div class="small text-muted">{{text}}</div>{{/notes}}
                <details>
                    <summary>{{headers.ladder}}</summary>
                    <table class="table table-sm">
                        <caption class="accesshide">{{headers.ladder}}: {{label}}</caption>
                        <thead>
                            <tr>
                                <th scope="col">{{headers.step}}</th>
                                <th scope="col">{{headers.state}}</th>
                                <th scope="col">{{headers.kind}}</th>
                                <th scope="col">{{headers.detail}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#steps}}
                            <tr data-step="{{step}}">
                                <th scope="row">{{stepname}}</th>
                                <td>{{state}}</td>
                                <td>{{kind}}</td>
                                <td>{{detail}} {{#time}}<span class="small text-muted">{{time}}</span>{{/time}}</td>
                            </tr>
                            {{/steps}}
                        </tbody>
                    </table>
                </details>
            </td>
            <td>{{next}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
</div>

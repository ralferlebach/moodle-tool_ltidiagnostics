{{!
    @template tool_ltidiagnostics/connection_list

    List of selectable LTI connections.

    Example context (json):
    {
        "caption": "Connections",
        "empty": "",
        "headers": {"name": "Name", "role": "Role", "issuer": "Issuer", "client": "Client ID", "deployment": "Deployment ID",
            "state": "State", "services": "Services", "usage": "Used in", "action": "Action"},
        "rows": [
            {"name": "Example tool (tool type id: 7)", "role": "Platform", "issuer": "https://platform.example",
             "clientid": "abcxyz", "deploymentid": "7", "state": "active", "services": "AGS, NRPS", "key": "platform:7",
             "edithtml": "", "usagehtml": "<ul><li>Graded task (id: 34)</li></ul>",
             "url": "https://moodle.example/admin/tool/ltidiagnostics/connection.php?key=platform:7", "actionlabel": "Open",
             "actions": [{"url": "https://moodle.example/admin/tool/ltidiagnostics/connection.php?key=platform:7",
                          "label": "Open", "aria": "Open Example tool"}]}
        ]
    }
}}
{{#empty}}<p class="alert alert-info">{{empty}}</p>{{/empty}}
{{^empty}}
<div class="table-responsive">
<table class="table table-striped generaltable" id="tool_ltidiagnostics_connections">
    <caption>{{caption}}</caption>
    <thead>
        <tr>
            <th scope="col">{{headers.name}}</th>
            <th scope="col">{{headers.role}}</th>
            <th scope="col">{{headers.issuer}}</th>
            <th scope="col">{{headers.client}}</th>
            <th scope="col">{{headers.deployment}}</th>
            <th scope="col">{{headers.state}}</th>
            <th scope="col">{{headers.services}}</th>
            <th scope="col">{{headers.usage}}</th>
            <th scope="col">{{headers.action}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr data-key="{{key}}">
            <th scope="row">{{name}}{{{edithtml}}}</th>
            <td>{{role}}</td>
            <td>{{issuer}}</td>
            <td>{{clientid}}</td>
            <td>{{deploymentid}}</td>
            <td>{{state}}</td>
            <td>{{services}}</td>
            <td>{{{usagehtml}}}</td>
            <td>{{#actions}}<a href="{{url}}" class="mr-2 me-2 d-inline-block" aria-label="{{aria}}">{{label}}</a>{{/actions}}</td>
        </tr>
        {{/rows}}
    </tbody>
</table>
</div>
{{/empty}}

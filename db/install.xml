<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/ltidiagnostics/db" VERSION="2026110300" COMMENT="XMLDB file for Moodle admin/tool/ltidiagnostics"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_ltidiagnostics_obs" COMMENT="Minimal observations of LTI related events (no payloads, no tokens, no names)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="traceid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Per-request trace id (or a sanitised X-Request-ID)"/>
        <FIELD NAME="eventtype" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="launch, enrolment, group, grade, service_unknown, view"/>
        <FIELD NAME="direction" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="in, out or local"/>
        <FIELD NAME="eventname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="connkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Connection key when it could be resolved unambiguously, else empty"/>
        <FIELD NAME="issuerhash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="SHA-256 of the issuer when known, else empty"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Affected user id (reference only, no profile data is copied)"/>
        <FIELD NAME="objectid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="entrypoint" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="web, lti_services, cli, ws or other"/>
        <FIELD NAME="fieldnames" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Names (never values) of the event other-data keys"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="UTC unix time"/>
        <FIELD NAME="correlationid" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false" COMMENT="other[correlationid] of an LTI family transfer event, else null"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="connkey_time" UNIQUE="false" FIELDS="connkey, timecreated"/>
        <INDEX NAME="traceid" UNIQUE="false" FIELDS="traceid"/>
        <INDEX NAME="course_time" UNIQUE="false" FIELDS="courseid, timecreated"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="correlationid" UNIQUE="false" FIELDS="correlationid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_audit" COMMENT="Audit of views and exports of diagnostic data">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="action" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="connkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="detail" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Short machine readable detail, never a secret"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_profile" COMMENT="Desired-state profiles (non-binding)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="connkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="profilejson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="connkey" UNIQUE="false" FIELDS="connkey"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_snap" COMMENT="Historised snapshots of the capability inventory and of reports">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="connkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="snapjson" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Redacted JSON, never contains secrets"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="connkey_kind_time" UNIQUE="false" FIELDS="connkey, kind, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_imp" COMMENT="Web server log import jobs (provenance of imported lines)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="access or error"/>
        <FIELD NAME="format" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourcetype" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="path or upload"/>
        <FIELD NAME="sourcename" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Base name only"/>
        <FIELD NAME="fingerprint" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="SHA-256 of the file content"/>
        <FIELD NAME="timezone" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="skew" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Configured clock skew in seconds that was added to the source times"/>
        <FIELD NAME="rangefrom" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="rangeto" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="linesread" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="linesstored" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="linesskipped" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="linesinvalid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="errormessage" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="fingerprint" UNIQUE="false" FIELDS="fingerprint"/>
        <INDEX NAME="user_time" UNIQUE="false" FIELDS="userid, timecreated" COMMENT="Import rate limit per user"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_acc" COMMENT="Redacted, LTI related web server log lines">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="importid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="linehash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Idempotency key"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="logtime" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="UTC unix time after timezone and skew normalisation"/>
        <FIELD NAME="method" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="path" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Path with query values redacted"/>
        <FIELD NAME="httpstatus" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="bytes" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="ipmask" TYPE="char" LENGTH="45" NOTNULL="true" SEQUENCE="false" COMMENT="Truncated client address, never used alone for correlation"/>
        <FIELD NAME="viaproxy" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="requestid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="category" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="One of parser::CATEGORIES"/>
        <FIELD NAME="message" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Redacted error log message"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="linehash" UNIQUE="true" FIELDS="linehash"/>
        <INDEX NAME="logtime" UNIQUE="false" FIELDS="logtime"/>
        <INDEX NAME="requestid" UNIQUE="false" FIELDS="requestid"/>
        <INDEX NAME="importid" UNIQUE="false" FIELDS="importid"/>
        <INDEX NAME="category_time" UNIQUE="false" FIELDS="category, logtime" COMMENT="Bounded queries per category and time window"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_gatt" COMMENT="Grade attempt journal: passive core sends from the task log and fully instrumented grade replays (no tokens, no bodies, no names)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false" COMMENT="Unique id of this attempt"/>
        <FIELD NAME="correlationid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Shared by an attempt and its retries"/>
        <FIELD NAME="parentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Journal row this attempt retries, 0 for a first attempt"/>
        <FIELD NAME="attemptno" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="origin" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="core_task, replay, replay_batch or replay_retry"/>
        <FIELD NAME="source" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="task_log (passive) or instrumented (own replay)"/>
        <FIELD NAME="sourcekey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Idempotency key (task log line or attempt id)"/>
        <FIELD NAME="connkey" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="deploymentrowid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="resourcelinkrowid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="enrol_lti_resource_link.id, 0 when the task log did not name one"/>
        <FIELD NAME="toolid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="enrol_lti_tools.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Local learner (shown pseudonymised)"/>
        <FIELD NAME="subjecthash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="sha256 of issuer and LTI subject used as AGS userId"/>
        <FIELD NAME="lineitemhash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="sha256 of the line item URL"/>
        <FIELD NAME="scoregiven" TYPE="number" LENGTH="15" NOTNULL="false" SEQUENCE="false" DECIMALS="5"/>
        <FIELD NAME="scoremax" TYPE="number" LENGTH="15" NOTNULL="false" SEQUENCE="false" DECIMALS="5"/>
        <FIELD NAME="sourceversion" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Fingerprint of the source grade at preview time"/>
        <FIELD NAME="gradetime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Original date graded, never changed"/>
        <FIELD NAME="agstimestamp" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Score.timestamp sent (re-issue time of the score state update)"/>
        <FIELD NAME="stateversion" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Monotonic score state version of the target"/>
        <FIELD NAME="state" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="skipreason" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="httpstatus" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="tokenstatus" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="none, granted, refused, scope_missing"/>
        <FIELD NAME="errorclass" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="retryat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="evidence" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="task_log or instrumented"/>
        <FIELD NAME="bookingstate" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false" COMMENT="unknown, unobservable, results_match, results_mismatch, receipt_confirmed, receipt_mismatch"/>
        <FIELD NAME="bookingdetail" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Comma separated mismatch codes"/>
        <FIELD NAME="bookingcheckedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="operatorid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Who requested a replay, 0 for core"/>
        <FIELD NAME="purpose" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Reason given by the operator"/>
        <FIELD NAME="batchid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false" COMMENT="Id of the confirmed selection (bulk replay) the attempt belongs to, empty for single replays and core sends"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="attemptid" UNIQUE="true" FIELDS="attemptid"/>
        <INDEX NAME="sourcekey" UNIQUE="true" FIELDS="sourcekey"/>
        <INDEX NAME="connkey_time" UNIQUE="false" FIELDS="connkey, timecreated"/>
        <INDEX NAME="link_user_time" UNIQUE="false" FIELDS="resourcelinkrowid, userid, timecreated"/>
        <INDEX NAME="correlationid" UNIQUE="false" FIELDS="correlationid"/>
        <INDEX NAME="state_retry" UNIQUE="false" FIELDS="state, retryat"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="operatorid" UNIQUE="false" FIELDS="operatorid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="batchid" UNIQUE="false" FIELDS="batchid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_gstate" COMMENT="Score state per replay target: monotonic version and last issued AGS timestamp">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="targethash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="sha256 of line item URL and subject"/>
        <FIELD NAME="version" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lastissued" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lastattemptid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="targethash" UNIQUE="true" FIELDS="targethash"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_ltidiagnostics_grcpt" COMMENT="Grade receipts imported from the partner site (consumer gradebook evidence, codes and values only)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="receipthash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="sha256 of the receipt document (idempotency)"/>
        <FIELD NAME="verdict" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="mismatches" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="scoregiven" TYPE="number" LENGTH="15" NOTNULL="false" SEQUENCE="false" DECIMALS="5"/>
        <FIELD NAME="scoremax" TYPE="number" LENGTH="15" NOTNULL="false" SEQUENCE="false" DECIMALS="5"/>
        <FIELD NAME="gradetime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="locked" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="overridden" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="issuedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When the partner created the receipt"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Who imported it"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="receipthash" UNIQUE="true" FIELDS="receipthash"/>
        <INDEX NAME="attemptid" UNIQUE="false" FIELDS="attemptid"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
